#EXTM3U
#
# Every tag from draft-pantos-hls-rfc8216bis-22
#

# Media Playlist tags
#EXT-X-TARGETDURATION:6
#EXT-X-VERSION:12
#EXT-X-MEDIA-SEQUENCE:266
#EXT-X-DISCONTINUITY-SEQUENCE:4
#EXT-X-PLAYLIST-TYPE:EVENT
#EXT-X-INDEPENDENT-SEGMENTS
#EXT-X-START:TIME-OFFSET=-30.0
#EXT-X-DEFINE:NAME="segment",VALUE="fileSequence"
#EXT-X-DEFINE:IMPORT="subtitle"
#EXT-X-KEY:METHOD=SAMPLE-AES,URI="skd://keys.example.com/key",IV=0X9c7db8778570d05c3177c349fd9236aa,KEYFORMAT="com.example.keyformat",KEYFORMATVERSIONS="1"
#EXT-X-MAP:URI="init.mp4",BYTERANGE="720@0"
#EXT-X-PROGRAM-DATE-TIME:2026-01-01T10:00:00.000+01:00
#EXT-X-BITRATE:143
#EXT-X-DATERANGE:ID="ad-1",CLASS="com.example.ad",START-DATE="2026-01-01T10:00:00Z",PLANNED-DURATION=30.0,SCTE35-OUT=0xFC002D,END-ON-NEXT=YES,X-COM-EXAMPLE-AD-ID="1234"
#EXT-X-BYTERANGE:82112@752321
#EXTINF:6.006,
fileSequence266.ts
#EXT-X-DISCONTINUITY
#EXT-X-GAP
#EXTINF:6.006,
fileSequence267.ts

# Low-Latency HLS tags
#EXT-X-SERVER-CONTROL:CAN-SKIP-UNTIL=120.0,PART-HOLD-BACK=12.0,CAN-BLOCK-RELOAD=YES,CAN-SKIP-DATERANGES=YES
#EXT-X-PART-INF:PART-TARGET=3.0
#EXT-X-PART:URI="filePart268.0.ts",DURATION=2.0,INDEPENDENT=YES,BYTERANGE="40000@0"
#EXT-X-PRELOAD-HINT:TYPE=PART,URI="filePart268.1.ts"
#EXT-X-RENDITION-REPORT:URI="../1M/index.m3u8",LAST-MSN=273,LAST-PART=2
#EXT-X-SKIP:SKIPPED-SEGMENTS=12
#EXTINF:6.006,
{$segment}268.ts
#EXT-X-ENDLIST

# Multivariant Playlist tags (in practice a separate file)
#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="aud1",NAME="English",LANGUAGE="en",ASSOC-LANGUAGE="en",DEFAULT=YES,AUTOSELECT=YES,CHANNELS="2",URI="a1/index.m3u8"
#EXT-X-SESSION-DATA:DATA-ID="com.example.data",VALUE="example-value",LANGUAGE="en"
#EXT-X-SESSION-KEY:METHOD=AES-128,URI="https://keys.example.com/key?id=2"
#EXT-X-CONTENT-STEERING:SERVER-URI="/steering?pathway=abcd",PATHWAY-ID="abcd"
#EXT-X-STREAM-INF:AVERAGE-BANDWIDTH=2000000,BANDWIDTH=2222222,SCORE=1.0,CODECS="avc1.64001f,mp4a.40.2",RESOLUTION=1280x720,FRAME-RATE=29.97,HDCP-LEVEL=TYPE-0,VIDEO-RANGE=SDR,STABLE-VARIANT-ID="720p",AUDIO="aud1",SUBTITLES="sub1",CLOSED-CAPTIONS=NONE,ALLOWED-CPC="com.example:60"
v0/index.m3u8
#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=151381,CODECS="avc1.64001f",HDCP-LEVEL=TYPE-0,URI="iframe_index.m3u8"
#EXT-X-I-FRAMES-ONLY
